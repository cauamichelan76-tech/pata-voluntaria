
:root {
    --verde: #176b4d;
    --verde-escuro: #104c38;
    --verde-claro: #e8f5ed;
    --fundo: #f7faf8;
    --texto: #20342b;
    --cinza: #66756d;
    --branco: #ffffff;
    --borda: #dce7df;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--texto);
    background: var(--fundo);
    line-height: 1.6;
}

.topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px max(5%, calc((100% - 1120px) / 2));
    background: var(--branco);
    border-bottom: 1px solid var(--borda);
}

.logo {
    color: var(--verde);
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
}

.topo span {
    color: var(--cinza);
    font-size: 0.9rem;
}

.container {
    width: min(1120px, 90%);
    margin: 0 auto;
}

.hero {
    margin: 36px 0 28px;
    padding: 54px;
    border-radius: 22px;
    background: linear-gradient(135deg, #e5f5e9, #f5fbf5);
}

.etiqueta {
    color: var(--verde);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.hero h1 {
    max-width: 720px;
    margin: 10px 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
}

.hero p:not(.etiqueta) {
    max-width: 620px;
    color: var(--cinza);
}

.botao {
    display: inline-block;
    padding: 12px 20px;
    border: 0;
    border-radius: 9px;
    background: var(--verde);
    color: var(--branco);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
}

.botao:hover {
    background: var(--verde-escuro);
    transform: translateY(-1px);
}

.painel {
    padding: 30px;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: 18px;
}

h2 {
    margin-top: 0;
}

form {
    display: grid;
    gap: 18px;
}

.campo {
    display: grid;
    gap: 7px;
}

label {
    font-size: 0.92rem;
    font-weight: 700;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd8ce;
    border-radius: 8px;
    background: var(--branco);
    color: var(--texto);
    font: inherit;
}

input:focus, select:focus, textarea:focus {
    outline: 2px solid #79bd99;
    outline-offset: 2px;
}

textarea {
    resize: vertical;
}

.painel .botao {
    justify-self: start;
}

.mensagem {
    padding: 13px 16px;
    border-radius: 9px;
}

.sucesso {
    background: #e0f5e7;
    color: #155c35;
}

.erro {
    background: #fff0ed;
    color: #9a3025;
}

.animais {
    margin: 44px 0;
}

.titulo-lista {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 20px;
}

.titulo-lista h2 {
    margin-bottom: 0;
}

.titulo-lista form {
    min-width: 190px;
    gap: 6px;
}

.grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
}

.cartao {
    overflow: hidden;
    border: 1px solid var(--borda);
    border-radius: 16px;
    background: var(--branco);
}

.icone-animal {
    display: grid;
    min-height: 130px;
    place-items: center;
    background: var(--verde-claro);
    font-size: 4rem;
}

.conteudo-cartao {
    padding: 20px;
}

.conteudo-cartao h3 {
    margin: 10px 0 0;
    font-size: 1.35rem;
}

.conteudo-cartao p {
    margin: 5px 0;
    color: var(--cinza);
}

.conteudo-cartao .descricao {
    margin-top: 14px;
    color: var(--texto);
    overflow-wrap: anywhere;
}

.status {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 20px;
    background: var(--verde-claro);
    color: var(--verde-escuro);
    font-size: 0.75rem;
    font-weight: 700;
}

.vazio {
    padding: 42px 20px;
    text-align: center;
    border: 1px dashed #bdcfc2;
    border-radius: 16px;
    background: var(--branco);
}

.vazio span {
    font-size: 2.5rem;
}

.vazio p {
    color: var(--cinza);
}

footer {
    padding: 24px 5%;
    text-align: center;
    background: var(--branco);
    border-top: 1px solid var(--borda);
    color: var(--cinza);
    font-size: 0.85rem;
}

@media (max-width: 650px) {
    .topo, .titulo-lista {
        align-items: stretch;
        flex-direction: column;
    }

    .topo span {
        display: none;
    }

    .hero {
        padding: 28px 22px;
    }

    .painel {
        padding: 22px;
    }

    .titulo-lista form {
        width: 100%;
    }
}

